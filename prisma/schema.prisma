generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

// Granular, independent of Role — a STUDENT can hold any of these without
// being a full ADMIN. SPORTS gates the SPORTS_* event categories; the rest
// gate their matching content type. SLB and EATS have no dedicated
// moderation surface yet — they exist so a super-admin can grant the scope
// now, ahead of content for it landing.
enum AdminScope {
  EVENTS
  CLUBS
  SPORTS
  NEWS
  WISDOM
  CHAT
  EATS
  SLB
  COURSES
  PROFESSORS
  DEARDKU
}

// Coordinate this with the "[Notifications] Per-category notification
// preferences in Settings" card — these are the categories a user will be
// able to opt in/out of. This card ships a "send everything" default;
// per-category filtering happens on top of PushSubscription in that card.
enum NotificationCategory {
  EVENTS
  MESSAGES
  RECOMMENDATIONS
  ORDERS
  ACADEMIC
  FRIENDS
}

enum PushDeliveryStatus {
  SENT
  FAILED
  PRUNED
}

enum PlanSemester {
  FALL
  SPRING
}

// DKU splits each semester into two 7-week sessions; Spring also has a
// one-week mini-term between its two sessions. FULL means a course that
// spans both sessions of its semester (common for lab/studio courses).
enum PlanSession {
  SESSION_1
  SESSION_2
  FULL
  MINI_TERM
}

// Gen-ed slots the Bulletin doesn't expose per-course (no per-course
// "attribute" data exists outside DKU's live registrar), so a placed course
// is tagged manually in the UI rather than auto-detected. Major-requirement
// and language-subject-code matches are auto-detected instead — see
// src/lib/major-requirements.ts and src/lib/planner-language.ts.
enum GenEdTag {
  COMMON_CORE_Y1
  COMMON_CORE_Y2
  COMMON_CORE_Y3
  DISTRIBUTION_NAS
  DISTRIBUTION_SS
  DISTRIBUTION_ARHU
  QUANTITATIVE_REASONING
  WRITING
  DUKE_FACULTY
}

model User {
  id            String    @id @default(cuid())
  netId         String?   @unique
  firstName     String
  lastName      String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  adminScopes   AdminScope[] @default([])
  emailVerified DateTime?
  image         String?
  communityScore Int      @default(0)
  showOnLeaderboard Boolean @default(true)
  // Social: birthday is month/day only (no year), opt-in, and only ever shown to mutual friends. Activity is
  // shown to followers unless turned off. Online status is shown to mutual friends unless turned off.
  birthdayMonth     Int?
  birthdayDay       Int?
  showBirthday      Boolean   @default(false)
  shareActivity     Boolean   @default(true)
  showOnlineStatus  Boolean   @default(true)
  lastSeenAt        DateTime?
  friendsSeenAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hiddenEventCategories EventCategory[] @default([])
  starredNav            String[]        @default([])
  starredNavMobile      String[]        @default([])

  verificationTokens VerificationToken[]
  hostedEvents       Event[]              @relation("EventHost")
  rsvps              Rsvp[]
  dashboardWidgets   DashboardWidget[]
  dailyVisits        DailyVisit[]
  following          Follow[]             @relation("FollowFollower")
  followers          Follow[]             @relation("FollowFollowing")
  chatReadStates     ChatReadState[]
  chatMentions       ChatMention[]
  chatChannelsCreated    ChatChannel[]        @relation("ChatChannelCreator")
  chatChannelMemberships ChatChannelMember[]  @relation("ChatChannelMemberUser")
  chatInvitesSent        ChatGroupInvite[]    @relation("ChatInviteInviter")
  chatInvitesReceived    ChatGroupInvite[]    @relation("ChatInviteInvitee")
  chatMessages           ChatMessage[]        @relation("ChatMessageAuthor")
  chatReactions          ChatMessageReaction[]
  wisdomTopics          WisdomTopic[]          @relation("WisdomTopicCreator")
  wisdomRecommendations WisdomRecommendation[] @relation("WisdomRecAuthor")
  wisdomVotes           WisdomVote[]
  dearDkuPosts          DearDkuPost[]          @relation("DearDkuPostAuthor")
  dearDkuComments       DearDkuComment[]       @relation("DearDkuCommentAuthor")
  clubsSubmitted     Club[]               @relation("ClubSubmitter")
  clubMemberships    ClubMembership[]     @relation("ClubMember")
  inviteCodesCreated InviteCode[]         @relation("InviteCodeCreator")
  inviteCodeUsed     InviteCode?          @relation("InviteCodeRedeemer")
  coursesSubmitted    Course[]            @relation("CourseSubmitter")
  professorsSubmitted Professor[]         @relation("ProfessorSubmitter")
  courseResources     CourseResource[]    @relation("CourseResourceAuthor")
  courseComments      CourseComment[]     @relation("CourseCommentAuthor")
  professorReviews    ProfessorReview[]   @relation("ProfessorReviewAuthor")
  scoreEvents         ScoreEvent[]
  pointEvents         PointEvent[]
  uploads             Upload[]
  pushSubscriptions   PushSubscription[]
  pushDeliveries      PushDelivery[]
  slbMembership       SlbMember?
  slbAboutEdits       SlbAbout[]
  slbAnnouncements    SlbAnnouncement[]
  slbPolls            SlbPoll[]
  slbPollVotes        SlbPollVote[]
  slbInitiatives      SlbInitiative[]
  slbBackings         SlbInitiativeBacker[]
  slbInitiativeVotes  SlbInitiativeVote[]
  notificationPreferences NotificationPreference[]
  academicPlans           AcademicPlan[]
  semesterCelebrations    SemesterCelebration[]

  @@map("users")
}

model InviteCode {
  id          String    @id @default(cuid())
  netId       String
  code        String    @unique
  createdById String
  createdBy   User      @relation("InviteCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedAt      DateTime?
  usedById    String?   @unique
  usedBy      User?     @relation("InviteCodeRedeemer", fields: [usedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([netId, code])
  @@map("invite_codes")
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("verification_tokens")
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum EventCategory {
  NATURAL_SCIENCE
  SOCIAL_SCIENCE
  ARTS_HUMANITIES
  ADMINISTRATIVE
  CLUBS
  SPORTS_OPEN_PLAY
  SPORTS_TOURNAMENTS
  RA_EVENTS
  SOCIAL_EVENTS
  PARTIES
}

enum EventKind {
  EVENT
  DEADLINE
  HOLIDAY
}

model Event {
  id            String         @id @default(cuid())
  title         String
  description   String
  location      String
  posterUrl     String?
  startsAt      DateTime
  endsAt        DateTime
  // All-day items (deadlines, holidays, all-day events) have no time or duration:
  // startsAt is 00:00 campus time on the day, endsAt is 24h later.
  allDay        Boolean        @default(false)
  kind          EventKind      @default(EVENT)
  recurrence    RecurrenceRule @default(NONE)
  category      EventCategory  @default(SOCIAL_EVENTS)
  approved      Boolean        @default(true)
  hostId        String
  host          User           @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  rsvps         Rsvp[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("events")
}

model Rsvp {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@map("rsvps")
}

