generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

// Granular, independent of Role — a STUDENT can hold any of these without
// being a full ADMIN. SPORTS gates the SPORTS_* event categories; the rest
// gate their matching content type. SLB and EATS have no dedicated
// moderation surface yet — they exist so a super-admin can grant the scope
// now, ahead of content for it landing.
enum AdminScope {
  EVENTS
  CLUBS
  SPORTS
  NEWS
  WISDOM
  BOARD
  EATS
  SLB
}

model User {
  id            String    @id @default(cuid())
  netId         String?   @unique
  firstName     String
  lastName      String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  adminScopes   AdminScope[] @default([])
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hiddenEventCategories EventCategory[] @default([])

  verificationTokens VerificationToken[]
  hostedEvents       Event[]              @relation("EventHost")
  rsvps              Rsvp[]
  dashboardWidgets   DashboardWidget[]
  boardPosts         BoardPost[]          @relation("BoardAuthor")
  boardComments      BoardComment[]       @relation("BoardCommentAuthor")
  wisdomPosts        WisdomPost[]         @relation("WisdomAuthor")
  wisdomVotes        WisdomVote[]
  newsPosts          NewsPost[]           @relation("NewsAuthor")
  clubsSubmitted     Club[]               @relation("ClubSubmitter")
  inviteCodesCreated InviteCode[]         @relation("InviteCodeCreator")
  inviteCodeUsed     InviteCode?          @relation("InviteCodeRedeemer")

  @@map("users")
}

model InviteCode {
  id          String    @id @default(cuid())
  netId       String
  code        String    @unique
  createdById String
  createdBy   User      @relation("InviteCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedAt      DateTime?
  usedById    String?   @unique
  usedBy      User?     @relation("InviteCodeRedeemer", fields: [usedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([netId, code])
  @@map("invite_codes")
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("verification_tokens")
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum EventCategory {
  NATURAL_SCIENCE
  SOCIAL_SCIENCE
  ARTS_HUMANITIES
  ADMINISTRATIVE
  CLUBS
  SPORTS_OPEN_PLAY
  SPORTS_TOURNAMENTS
  RA_EVENTS
  SOCIAL_EVENTS
  PARTIES
}

model Event {
  id            String         @id @default(cuid())
  title         String
  description   String
  location      String
  posterUrl     String?
  startsAt      DateTime
  endsAt        DateTime
  recurrence    RecurrenceRule @default(NONE)
  category      EventCategory  @default(SOCIAL_EVENTS)
  approved      Boolean        @default(true)
  hostId        String
  host          User           @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  rsvps         Rsvp[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("events")
}

model Rsvp {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@map("rsvps")
}

enum WidgetType {
  EVENTS
  DKU_EATS
  SOCIAL
  NEWS
  WISDOM
  CLUBS
  MARKETPLACE
  SLB
}

enum WidgetSize {
  SMALL
  MEDIUM
  LARGE
}

model DashboardWidget {
  id       String     @id @default(cuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     WidgetType
  size     WidgetSize @default(MEDIUM)
  position Int        @default(0)

  @@map("dashboard_widgets")
}

model BoardPost {
  id        String         @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    User           @relation("BoardAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments  BoardComment[]
  createdAt DateTime       @default(now())

  @@map("board_posts")
}

model BoardComment {
  id        String    @id @default(cuid())
  postId    String
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("BoardCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())

  @@map("board_comments")
}

enum WisdomCategory {
  FOOD
  NIGHTLIFE
  ACTIVITIES
  TRAVEL
  STUDY
  OTHER
}

model WisdomPost {
  id        String         @id @default(cuid())
  title     String
  category  WisdomCategory
  location  String?
  body      String
  authorId  String
  author    User           @relation("WisdomAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  votes     WisdomVote[]
  createdAt DateTime       @default(now())

  @@map("wisdom_posts")
}

model WisdomVote {
  id     String     @id @default(cuid())
  postId String
  post   WisdomPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  value  Int

  @@unique([postId, userId])
  @@map("wisdom_votes")
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  summary     String
  body        String
  authorId    String
  author      User     @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  publishedAt DateTime @default(now())

  @@map("news_posts")
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_signups")
}

enum ClubCategory {
  ACADEMIC
  ARTS
  SPORTS
  CULTURAL
  SERVICE
  SOCIAL
  OTHER
}

model Club {
  id            String       @id @default(cuid())
  name          String
  category      ClubCategory
  description   String
  contact       String?
  logoUrl       String?
  approved      Boolean      @default(true)
  submittedById String
  submittedBy   User         @relation("ClubSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@map("clubs")
}
