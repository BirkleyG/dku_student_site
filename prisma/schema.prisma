generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

// Granular, independent of Role — a STUDENT can hold any of these without
// being a full ADMIN. SPORTS gates the SPORTS_* event categories; the rest
// gate their matching content type. SLB and EATS have no dedicated
// moderation surface yet — they exist so a super-admin can grant the scope
// now, ahead of content for it landing.
enum AdminScope {
  EVENTS
  CLUBS
  SPORTS
  NEWS
  WISDOM
  BOARD
  EATS
  SLB
  COURSES
  PROFESSORS
}

model User {
  id            String    @id @default(cuid())
  netId         String?   @unique
  firstName     String
  lastName      String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  adminScopes   AdminScope[] @default([])
  emailVerified DateTime?
  image         String?
  communityScore Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hiddenEventCategories EventCategory[] @default([])

  verificationTokens VerificationToken[]
  hostedEvents       Event[]              @relation("EventHost")
  rsvps              Rsvp[]
  dashboardWidgets   DashboardWidget[]
  boardPosts         BoardPost[]          @relation("BoardAuthor")
  boardComments      BoardComment[]       @relation("BoardCommentAuthor")
  wisdomPosts        WisdomPost[]         @relation("WisdomAuthor")
  wisdomVotes        WisdomVote[]
  newsPosts          NewsPost[]           @relation("NewsAuthor")
  clubsSubmitted     Club[]               @relation("ClubSubmitter")
  inviteCodesCreated InviteCode[]         @relation("InviteCodeCreator")
  inviteCodeUsed     InviteCode?          @relation("InviteCodeRedeemer")
  coursesSubmitted    Course[]            @relation("CourseSubmitter")
  professorsSubmitted Professor[]         @relation("ProfessorSubmitter")
  courseResources     CourseResource[]    @relation("CourseResourceAuthor")
  professorReviews    ProfessorReview[]   @relation("ProfessorReviewAuthor")
  scoreEvents         ScoreEvent[]

  @@map("users")
}

model InviteCode {
  id          String    @id @default(cuid())
  netId       String
  code        String    @unique
  createdById String
  createdBy   User      @relation("InviteCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedAt      DateTime?
  usedById    String?   @unique
  usedBy      User?     @relation("InviteCodeRedeemer", fields: [usedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([netId, code])
  @@map("invite_codes")
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("verification_tokens")
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum EventCategory {
  NATURAL_SCIENCE
  SOCIAL_SCIENCE
  ARTS_HUMANITIES
  ADMINISTRATIVE
  CLUBS
  SPORTS_OPEN_PLAY
  SPORTS_TOURNAMENTS
  RA_EVENTS
  SOCIAL_EVENTS
  PARTIES
}

model Event {
  id            String         @id @default(cuid())
  title         String
  description   String
  location      String
  posterUrl     String?
  startsAt      DateTime
  endsAt        DateTime
  recurrence    RecurrenceRule @default(NONE)
  category      EventCategory  @default(SOCIAL_EVENTS)
  approved      Boolean        @default(true)
  hostId        String
  host          User           @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  rsvps         Rsvp[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("events")
}

model Rsvp {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@map("rsvps")
}

enum WidgetType {
  EVENTS
  DKU_EATS
  SOCIAL
  NEWS
  WISDOM
  CLUBS
}

model DashboardWidget {
  id       String     @id @default(cuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     WidgetType
  position Int        @default(0)

  @@unique([userId, type])
  @@map("dashboard_widgets")
}

model BoardPost {
  id        String         @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    User           @relation("BoardAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments  BoardComment[]
  createdAt DateTime       @default(now())

  @@map("board_posts")
}

model BoardComment {
  id        String    @id @default(cuid())
  postId    String
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("BoardCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())

  @@map("board_comments")
}

enum WisdomCategory {
  FOOD
  NIGHTLIFE
  ACTIVITIES
  TRAVEL
  STUDY
  OTHER
}

model WisdomPost {
  id        String         @id @default(cuid())
  title     String
  category  WisdomCategory
  location  String?
  body      String
  authorId  String
  author    User           @relation("WisdomAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  votes     WisdomVote[]
  createdAt DateTime       @default(now())

  @@map("wisdom_posts")
}

model WisdomVote {
  id     String     @id @default(cuid())
  postId String
  post   WisdomPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  value  Int

  @@unique([postId, userId])
  @@map("wisdom_votes")
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  summary     String
  body        String
  authorId    String
  author      User     @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  publishedAt DateTime @default(now())

  @@map("news_posts")
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_signups")
}

enum ClubCategory {
  ACADEMIC
  ARTS
  SPORTS
  CULTURAL
  SERVICE
  SOCIAL
  OTHER
}

model Club {
  id            String       @id @default(cuid())
  name          String
  category      ClubCategory
  description   String
  contact       String?
  logoUrl       String?
  approved      Boolean      @default(true)
  submittedById String
  submittedBy   User         @relation("ClubSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@map("clubs")
}

model Professor {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  department  String
  email       String?
  verified    Boolean  @default(false)
  addedById   String
  addedBy     User     @relation("ProfessorSubmitter", fields: [addedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  offerings CourseOffering[]
  reviews   ProfessorReview[]

  @@map("professors")
}

model Course {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  department  String
  description String?
  createdById String
  createdBy   User     @relation("CourseSubmitter", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  offerings CourseOffering[]
  resources CourseResource[]
  reviews   ProfessorReview[]

  @@map("courses")
}

model CourseOffering {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  semester    String

  @@unique([courseId, professorId, semester])
  @@map("course_offerings")
}

enum CourseResourceType {
  SYLLABUS
  NOTES
  EXAM
  TIP
}

model CourseResource {
  id        String             @id @default(cuid())
  courseId  String
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type      CourseResourceType
  semester  String?
  title     String
  body      String?
  fileUrl   String?
  authorId  String
  author    User               @relation("CourseResourceAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@map("course_resources")
}

model ProfessorReview {
  id               String    @id @default(cuid())
  professorId      String
  professor        Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  courseId         String?
  course           Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  authorId         String
  author           User      @relation("ProfessorReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  gradingRating    Int
  difficultyRating Int
  teachingRating   Int
  comment          String?
  createdAt        DateTime  @default(now())

  @@unique([professorId, authorId, courseId])
  @@map("professor_reviews")
}

enum ScoreReason {
  WISDOM_POST
  BOARD_POST
  BOARD_COMMENT
  PROFESSOR_REVIEW
  COURSE_RESOURCE
  COURSE_ADDED
  PROFESSOR_ADDED
}

model ScoreEvent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    ScoreReason
  points    Int
  createdAt DateTime    @default(now())

  @@map("score_events")
}
