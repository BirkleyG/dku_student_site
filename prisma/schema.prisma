  EVENTS_TALLY
  EVENTS_AGENDA
  EATS_OPEN_COUNT
  EATS_FAVORITE
  EATS_ORDER_TRACKER
  EATS_ACTIVITY
  CHAT_LATEST
  CHAT_RECENT
  CHAT_TRACKED_CHANNEL
  LILYPAD_LATEST
  EVENTS_NEXT_RSVP
  EVENTS_MY_WEEK
  EVENTS_HOST_LAUNCH
  EVENTS_TRENDING
  EVENTS_HOSTING
  EVENTS_HAPPENING_NOW
  EVENTS_DEADLINE
  SLB_LATEST
  SLB_POLL
  SLB_TRENDING
  LILYPAD_HEADLINE
  LILYPAD_TICKER
  WISDOM_TOP
  WISDOM_TALLY
  WISDOM_SURPRISE
  WISDOM_DAILY
  WISDOM_NEWEST
  WISDOM_UPVOTES
  WISDOM_SHARE
  CLUBS_SPOTLIGHT
  CLUBS_MINE
  CLUBS_NEWEST
  EATS_RANDOM
  EATS_BUSY
  EATS_LAST_ORDER
  CHAT_COMPOSER
  CHAT_PINNED
  CHAT_INVITES
  CHAT_DM
  DEAR_LATEST
  DEAR_COMMENTED
  DEAR_WRITE
  DEAR_RANDOM
  COURSES_COMMENTS
  COURSES_SEARCH
  COURSES_RESOURCES
  PROFESSORS_SPOTLIGHT
