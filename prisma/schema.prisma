generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

// Granular, independent of Role — a STUDENT can hold any of these without
// being a full ADMIN. SPORTS gates the SPORTS_* event categories; the rest
// gate their matching content type. SLB and EATS have no dedicated
// moderation surface yet — they exist so a super-admin can grant the scope
// now, ahead of content for it landing.
enum AdminScope {
  EVENTS
  CLUBS
  SPORTS
  NEWS
  WISDOM
  BOARD
  EATS
  SLB
  COURSES
  PROFESSORS
}

// Coordinate this with the "[Notifications] Per-category notification
// preferences in Settings" card — these are the categories a user will be
// able to opt in/out of. This card ships a "send everything" default;
// per-category filtering happens on top of PushSubscription in that card.
enum NotificationCategory {
  EVENTS
  POSTS
  RECOMMENDATIONS
  ORDERS
}

enum PushDeliveryStatus {
  SENT
  FAILED
  PRUNED
}

model User {
  id            String    @id @default(cuid())
  netId         String?   @unique
  firstName     String
  lastName      String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  adminScopes   AdminScope[] @default([])
  emailVerified DateTime?
  image         String?
  communityScore Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hiddenEventCategories EventCategory[] @default([])
  starredNav            String[]        @default([])

  verificationTokens VerificationToken[]
  hostedEvents       Event[]              @relation("EventHost")
  rsvps              Rsvp[]
  dashboardWidgets   DashboardWidget[]
  boardPosts         BoardPost[]          @relation("BoardAuthor")
  boardComments      BoardComment[]       @relation("BoardCommentAuthor")
  wisdomTopics          WisdomTopic[]          @relation("WisdomTopicCreator")
  wisdomRecommendations WisdomRecommendation[] @relation("WisdomRecAuthor")
  wisdomVotes           WisdomVote[]
  clubsSubmitted     Club[]               @relation("ClubSubmitter")
  clubMemberships    ClubMembership[]     @relation("ClubMember")
  inviteCodesCreated InviteCode[]         @relation("InviteCodeCreator")
  inviteCodeUsed     InviteCode?          @relation("InviteCodeRedeemer")
  coursesSubmitted    Course[]            @relation("CourseSubmitter")
  professorsSubmitted Professor[]         @relation("ProfessorSubmitter")
  courseResources     CourseResource[]    @relation("CourseResourceAuthor")
  courseComments      CourseComment[]     @relation("CourseCommentAuthor")
  professorReviews    ProfessorReview[]   @relation("ProfessorReviewAuthor")
  scoreEvents         ScoreEvent[]
  uploads             Upload[]
  pushSubscriptions   PushSubscription[]
  pushDeliveries      PushDelivery[]
  slbMembership       SlbMember?
  slbAboutEdits       SlbAbout[]
  slbAnnouncements    SlbAnnouncement[]
  slbPolls            SlbPoll[]
  slbPollVotes        SlbPollVote[]
  slbInitiatives      SlbInitiative[]
  slbBackings         SlbInitiativeBacker[]
  slbInitiativeVotes  SlbInitiativeVote[]
  notificationPreferences NotificationPreference[]

  @@map("users")
}

model InviteCode {
  id          String    @id @default(cuid())
  netId       String
  code        String    @unique
  createdById String
  createdBy   User      @relation("InviteCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedAt      DateTime?
  usedById    String?   @unique
  usedBy      User?     @relation("InviteCodeRedeemer", fields: [usedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([netId, code])
  @@map("invite_codes")
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("verification_tokens")
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum EventCategory {
  NATURAL_SCIENCE
  SOCIAL_SCIENCE
  ARTS_HUMANITIES
  ADMINISTRATIVE
  CLUBS
  SPORTS_OPEN_PLAY
  SPORTS_TOURNAMENTS
  RA_EVENTS
  SOCIAL_EVENTS
  PARTIES
}

model Event {
  id            String         @id @default(cuid())
  title         String
  description   String
  location      String
  posterUrl     String?
  startsAt      DateTime
  endsAt        DateTime
  recurrence    RecurrenceRule @default(NONE)
  category      EventCategory  @default(SOCIAL_EVENTS)
  approved      Boolean        @default(true)
  hostId        String
  host          User           @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  rsvps         Rsvp[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("events")
}

model Rsvp {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@map("rsvps")
}

enum WidgetKind {
  EVENTS_TALLY
  EVENTS_AGENDA
  EATS_OPEN_COUNT
  EATS_FAVORITE
  EATS_ORDER_TRACKER
  EATS_ACTIVITY
  BOARD_LATEST
  BOARD_RECENT
  BOARD_TRACKED_POST
  LILYPAD_LATEST
}

model DashboardWidget {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      WidgetKind
  config    Json?
  position  Int        @default(0)
  createdAt DateTime   @default(now())

  @@map("dashboard_widgets")
}

model BoardPost {
  id        String         @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    User           @relation("BoardAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments  BoardComment[]
  createdAt DateTime       @default(now())

  @@map("board_posts")
}

model BoardComment {
  id        String    @id @default(cuid())
  postId    String
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("BoardCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())

  @@map("board_comments")
}

enum WisdomCategory {
  FOOD
  NIGHTLIFE
  ACTIVITIES
  TRAVEL
  STUDY
  OTHER
}

/** A question/category people crowdsource recommendations for, e.g. "Best Western food near campus". */
model WisdomTopic {
  id              String                 @id @default(cuid())
  title           String
  description     String?
  category        WisdomCategory         @default(OTHER)
  requireLocation Boolean                @default(false)
  createdById     String
  createdBy       User                   @relation("WisdomTopicCreator", fields: [createdById], references: [id], onDelete: Cascade)
  recommendations WisdomRecommendation[]
  createdAt       DateTime               @default(now())

  @@map("wisdom_topics")
}

/** One person's suggested answer to a WisdomTopic — a place, where it is, and why. */
model WisdomRecommendation {
  id          String       @id @default(cuid())
  topicId     String
  topic       WisdomTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  placeName   String
  location    String?
  description String
  authorId    String
  author      User         @relation("WisdomRecAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  votes       WisdomVote[]
  createdAt   DateTime     @default(now())

  @@map("wisdom_recommendations")
}

model WisdomVote {
  id               String               @id @default(cuid())
  recommendationId String
  recommendation   WisdomRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  value            Int

  @@unique([recommendationId, userId])
  @@map("wisdom_votes")
}


// CLUB is a student-run interest group; ORGANIZATION covers non-club bodies
// (e.g. the Athletics department itself, hosting varsity teams and rec clubs).
enum GroupType {
  CLUB
  ORGANIZATION
}

enum ClubCategory {
  ACADEMIC
  ARTS
  CULTURAL
  SERVICE
  SOCIAL
  PROFESSIONAL
  ATHLETIC
  OTHER
}

// Only meaningful when category is ATHLETIC — distinguishes a varsity team
// from a recreational sports club.
enum AthleticKind {
  VARSITY_TEAM
  SPORTS_CLUB
}

enum ContactMethod {
  EMAIL
  WECHAT
  PHONE
  OTHER
}

enum ClubMemberRole {
  MEMBER
  MANAGER
}

model Club {
  id            String        @id @default(cuid())
  type          GroupType     @default(CLUB)
  name          String
  category      ClubCategory
  athleticKind  AthleticKind?
  sportName     String?
  description   String
  contactMethod ContactMethod @default(EMAIL)
  contactValue  String?
  contactQrUrl  String?
  website       String?
  logoUrl       String?
  openJoin      Boolean       @default(true)
  approved      Boolean       @default(true)
  submittedById String
  submittedBy   User          @relation("ClubSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  officers ClubOfficer[]
  members  ClubMembership[]

  @@map("clubs")
}

model ClubOfficer {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  title     String
  contact   String?
  createdAt DateTime @default(now())

  @@map("club_officers")
}

model ClubMembership {
  id       String         @id @default(cuid())
  clubId   String
  club     Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation("ClubMember", fields: [userId], references: [id], onDelete: Cascade)
  role     ClubMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  @@unique([clubId, userId])
  @@map("club_memberships")
}

model Professor {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  department  String
  email       String?
  verified    Boolean  @default(false)
  addedById   String
  addedBy     User     @relation("ProfessorSubmitter", fields: [addedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  offerings CourseOffering[]
  reviews   ProfessorReview[]

  @@map("professors")
}

model Course {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  department  String
  credits     String?
  description String?
  createdById String
  createdBy   User     @relation("CourseSubmitter", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  offerings CourseOffering[]
  resources CourseResource[]
  comments  CourseComment[]
  reviews   ProfessorReview[]

  @@map("courses")
}

model CourseComment {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CourseCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@map("course_comments")
}

model CourseOffering {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  semester    String

  @@unique([courseId, professorId, semester])
  @@map("course_offerings")
}

enum CourseResourceType {
  SYLLABUS
  NOTES
  EXAM
  MATERIALS
  TIP
}

model CourseResource {
  id        String             @id @default(cuid())
  courseId  String
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type      CourseResourceType
  semester  String?
  title     String
  body      String?
  fileUrl   String?
  authorId  String
  author    User               @relation("CourseResourceAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@map("course_resources")
}

model ProfessorReview {
  id               String    @id @default(cuid())
  professorId      String
  professor        Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  courseId         String?
  course           Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  authorId         String
  author           User      @relation("ProfessorReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  gradingRating    Int
  difficultyRating Int
  teachingRating   Int
  comment          String?
  createdAt        DateTime  @default(now())

  @@unique([professorId, authorId, courseId])
  @@map("professor_reviews")
}

enum ScoreReason {
  WISDOM_POST
  BOARD_POST
  BOARD_COMMENT
  PROFESSOR_REVIEW
  COURSE_RESOURCE
  COURSE_ADDED
  PROFESSOR_ADDED
  COURSE_COMMENT
}

model ScoreEvent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    ScoreReason
  points    Int
  createdAt DateTime    @default(now())

  @@map("score_events")
}

// Small user-uploaded images (event posters), stored in Postgres so uploads
// need no extra storage service. Images are downscaled in the browser before
// upload and capped server-side, so rows stay small.
model Upload {
  id          String   @id @default(cuid())
  data        Bytes
  contentType String
  size        Int
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("uploads")
}

// ---------------------------------------------------------------------------
// Student Leaders Board: members, About page, announcements, polls, and
// initiatives (member-sponsored proposals the community votes on).

model SlbMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())

  @@map("slb_members")
}

// Single row (id "about"), editable by SLB members.
model SlbAbout {
  id          String   @id
  body        String
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@map("slb_about")
}

model SlbAnnouncement {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("slb_announcements")
}

model SlbPoll {
  id        String          @id @default(cuid())
  question  String
  authorId  String
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  closesAt  DateTime?
  options   SlbPollOption[]
  votes     SlbPollVote[]
  createdAt DateTime        @default(now())

  @@map("slb_polls")
}

model SlbPollOption {
  id       String        @id @default(cuid())
  pollId   String
  poll     SlbPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label    String
  position Int
  votes    SlbPollVote[]

  @@map("slb_poll_options")
}

model SlbPollVote {
  id        String        @id @default(cuid())
  pollId    String
  poll      SlbPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    SlbPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([pollId, userId])
  @@map("slb_poll_votes")
}

enum SlbInitiativeStatus {
  PROPOSED
  IN_PROGRESS
  PASSED
  NOT_PASSED
}

model SlbInitiative {
  id        String                @id @default(cuid())
  title     String
  summary   String
  body      String
  status    SlbInitiativeStatus   @default(PROPOSED)
  sponsorId String
  sponsor   User                  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  backers   SlbInitiativeBacker[]
  votes     SlbInitiativeVote[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("slb_initiatives")
}

// SLB members (other than the sponsor) who co-sponsor an initiative.
model SlbInitiativeBacker {
  id           String        @id @default(cuid())
  initiativeId String
  initiative   SlbInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@unique([initiativeId, userId])
  @@map("slb_initiative_backers")
}

// Community vote: +1 = "Yes, I want this", -1 = "No".
model SlbInitiativeVote {
  id           String        @id @default(cuid())
  initiativeId String
  initiative   SlbInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  value        Int

  @@unique([initiativeId, userId])
  @@map("slb_initiative_votes")
}

// One row per browser/device push subscription (a user may have several —
// phone, laptop, etc). endpoint is the push service URL PushManager.subscribe()
// returns; it's globally unique per subscription.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  deliveries PushDelivery[]

  @@index([userId])
  @@map("push_subscriptions")
}

// Delivery record for a single push send to a single subscription, used to
// drive retry-with-backoff and to give an auditable trail of what was sent
// and why a send failed. Not a full job queue (see PR notes) — attempts
// happen inline (with backoff) during the triggering request via
// `next/server`'s `after()`, and this table lets a follow-up sweep retry
// anything left FAILED.
model PushDelivery {
  id             String                @id @default(cuid())
  category       NotificationCategory
  title          String
  body           String
  url            String?
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   PushSubscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  status         PushDeliveryStatus
  attempts       Int                   @default(1)
  lastError      String?
  createdAt      DateTime              @default(now())

  @@index([userId])
  @@index([status])
  @@map("push_deliveries")
}

// Per-user, per-category push notification preference. Opt-out model: a
// missing row for a (userId, category) pair means "enabled" — see
// src/lib/notification-preferences.ts for the default-on read helper.
model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, category])
  @@map("notification_preferences")
}
