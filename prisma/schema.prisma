model DashboardWidget {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      WidgetKind
  config    Json?
  position  Int        @default(0)
  createdAt DateTime   @default(now())

  @@map("dashboard_widgets")
}

/// One row per user per campus day they opened the Home dashboard. Powers the login-streak widget and the
/// admin active-users widget. `day` is a campus-time "yyyy-MM-dd" key.
model DailyVisit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
  @@map("daily_visits")
}

enum ChatChannelKind {
  GENERAL
  GROUP
  DIRECT
}

// One row per chat surface: the single sitewide GENERAL channel (id "general",
// implicit membership for every user), an admin-created GROUP channel joined
// via inviteCode (nationality/class-year communities etc.), or a 2-member
// DIRECT channel created on demand between two users.
model ChatChannel {
  id          String              @id @default(cuid())
  kind        ChatChannelKind
  name        String
  description String?
  inviteCode  String?             @unique
  createdById String?
  createdBy   User?               @relation("ChatChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     ChatChannelMember[]
  messages    ChatMessage[]
  invites     ChatGroupInvite[]
  readStates  ChatReadState[]
  createdAt   DateTime            @default(now())

  @@map("chat_channels")
}

model ChatChannelMember {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ChatChannelMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime    @default(now())

  @@unique([channelId, userId])
  @@map("chat_channel_members")
}

enum ChatInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A group owner's invitation for another user to join a GROUP channel. The
// invitee accepts (becomes a member) or declines. One row per (channel, invitee);
// a declined invite can be re-sent by resetting it to PENDING.
model ChatGroupInvite {
  id        String           @id @default(cuid())
  channelId String
  channel   ChatChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  inviterId String
  inviter   User             @relation("ChatInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User             @relation("ChatInviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status    ChatInviteStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([channelId, inviteeId])
  @@index([inviteeId, status])
  @@map("chat_group_invites")
}

// parentId null = a top-level message in the channel; non-null = a threaded
// reply (Slack-style — one level deep, replies don't nest further).
model ChatMessage {
  id        String        @id @default(cuid())
  channelId String
  channel   ChatChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  parentId  String?
  parent    ChatMessage?  @relation("ChatMessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ChatMessage[] @relation("ChatMessageReplies")
  reactions ChatMessageReaction[]
  mentions  ChatMention[]
  createdAt DateTime      @default(now())

  @@index([channelId, parentId, createdAt])
  @@map("chat_messages")
}

// One row per (message, user, emoji) — a user can react to the same message
// with several different emoji, but not stack the same one twice.
/// When a user last looked at a chat. Unread = messages from other people newer than this. The open chat
/// refreshes it on every poll, so it stays 0 while you're reading.
model ChatReadState {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId  String
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadAt DateTime    @default(now())

  @@unique([userId, channelId])
  @@map("chat_read_states")
}

/// An @mention of a user in a message. readAt is set once they open that chat.
model ChatMention {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("chat_mentions")
}

model ChatMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@map("chat_message_reactions")
}

enum WisdomCategory {
  FOOD
  NIGHTLIFE
  ACTIVITIES
  TRAVEL
  STUDY
  BEAUTY_NATURE
  OTHER
}

/** A question/category people crowdsource recommendations for, e.g. "Best Western food near campus". */
model WisdomTopic {
  id              String                 @id @default(cuid())
  title           String
  description     String?
  category        WisdomCategory         @default(OTHER)
  requireLocation Boolean                @default(false)
  createdById     String
  createdBy       User                   @relation("WisdomTopicCreator", fields: [createdById], references: [id], onDelete: Cascade)
  recommendations WisdomRecommendation[]
  createdAt       DateTime               @default(now())

  @@map("wisdom_topics")
}

/** One person's suggested answer to a WisdomTopic — a place, where it is, and why. */
model WisdomRecommendation {
  id          String       @id @default(cuid())
  topicId     String
  topic       WisdomTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  placeName   String
  location    String?
  description String
  authorId    String
  author      User         @relation("WisdomRecAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  votes       WisdomVote[]
  createdAt   DateTime     @default(now())

  @@map("wisdom_recommendations")
}

model WisdomVote {
  id               String               @id @default(cuid())
  recommendationId String
  recommendation   WisdomRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  value            Int

  @@unique([recommendationId, userId])
  @@map("wisdom_votes")
}

enum DearDkuCategory {
  OPINION
  ESSAY
  CREATIVE_WRITING
  ART
  CAMPUS_LIFE
  OTHER
}

enum DearDkuSubmissionType {
  GOOGLE_DOC
  FILE
}

/** A published thought/opinion/art piece, either linked as a comment-only Google Doc or uploaded as a file. */
model DearDkuPost {
  id             String                 @id @default(cuid())
  title          String
  summary        String
  category       DearDkuCategory        @default(OTHER)
  submissionType DearDkuSubmissionType  @default(GOOGLE_DOC)
  docUrl         String?
  fileUrl        String?
  authorId       String
  author         User                   @relation("DearDkuPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments       DearDkuComment[]
  createdAt      DateTime               @default(now())

  @@map("dear_dku_posts")
}

model DearDkuComment {
  id        String      @id @default(cuid())
  postId    String
  post      DearDkuPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation("DearDkuCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now())

  @@map("dear_dku_comments")
}

// CLUB is a student-run interest group; ORGANIZATION covers non-club bodies
// (e.g. the Athletics department itself, hosting varsity teams and rec clubs).
enum GroupType {
  CLUB
  ORGANIZATION
}

enum ClubCategory {
  ACADEMIC
  ARTS
  CULTURAL
  SERVICE
  SOCIAL
  PROFESSIONAL
  ATHLETIC
  OTHER
}

// Only meaningful when category is ATHLETIC — distinguishes a varsity team
// from a recreational sports club.
enum AthleticKind {
  VARSITY_TEAM
  SPORTS_CLUB
}

enum ContactMethod {
  EMAIL
  WECHAT
  PHONE
  OTHER
}

enum ClubMemberRole {
  MEMBER
  MANAGER
}

model Club {
  id            String        @id @default(cuid())
  type          GroupType     @default(CLUB)
  name          String
  category      ClubCategory
  athleticKind  AthleticKind?
  sportName     String?
  description   String
  contactMethod ContactMethod @default(EMAIL)
  contactValue  String?
  contactQrUrl  String?
  website       String?
  logoUrl       String?
  openJoin      Boolean       @default(true)
  approved      Boolean       @default(true)
  submittedById String
  submittedBy   User          @relation("ClubSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  officers ClubOfficer[]
  members  ClubMembership[]

  @@map("clubs")
}

model ClubOfficer {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  title     String
  contact   String?
  createdAt DateTime @default(now())

  @@map("club_officers")
}

model ClubMembership {
  id       String         @id @default(cuid())
  clubId   String
  club     Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation("ClubMember", fields: [userId], references: [id], onDelete: Cascade)
  role     ClubMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  @@unique([clubId, userId])
  @@map("club_memberships")
}

model Professor {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  department  String
  email       String?
  verified    Boolean  @default(false)
  addedById   String
  addedBy     User     @relation("ProfessorSubmitter", fields: [addedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  offerings CourseOffering[]
  reviews   ProfessorReview[]
  resources CourseResource[]

  @@map("professors")
}

model Course {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  department  String
  credits     String?
  description String?
  createdById String
  createdBy   User     @relation("CourseSubmitter", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  offerings CourseOffering[]
  resources CourseResource[]
  comments  CourseComment[]
  reviews   ProfessorReview[]

  @@map("courses")
}

model CourseComment {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CourseCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@map("course_comments")
}

model CourseOffering {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  semester    String

  @@unique([courseId, professorId, semester])
  @@map("course_offerings")
}

enum CourseResourceType {
  SYLLABUS
  NOTES
  EXAM
  MATERIALS
  TIP
}

enum CourseExamType {
  MIDTERM
  FINAL
  OTHER
}

model CourseResource {
  id          String             @id @default(cuid())
  courseId    String
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type        CourseResourceType
  semester    String?
  title       String
  body        String?
  fileUrl     String?
  fileName    String?
  // Syllabuses and past exams are tied to the professor who taught them.
  professorId String?
  professor   Professor?         @relation(fields: [professorId], references: [id], onDelete: SetNull)
  examType    CourseExamType?
  authorId    String
  author      User               @relation("CourseResourceAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())

  @@map("course_resources")
}

model ProfessorReview {
  id               String    @id @default(cuid())
  professorId      String
  professor        Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  courseId         String?
  course           Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  authorId         String
  author           User      @relation("ProfessorReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  gradingRating    Int
  funRating        Int
  teachingRating   Int
  comment          String?
  createdAt        DateTime  @default(now())

  @@unique([professorId, authorId, courseId])
  @@map("professor_reviews")
}

enum ScoreReason {
  WISDOM_POST
  CHAT_MESSAGE
  CHAT_REPLY
  PROFESSOR_REVIEW
  COURSE_RESOURCE
  COURSE_ADDED
  PROFESSOR_ADDED
  COURSE_COMMENT
}

model ScoreEvent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    ScoreReason
  points    Int
  createdAt DateTime    @default(now())

  @@map("score_events")
}

// Append-only points ledger. Activity rows (kind ACTIVITY) pay points per object,
// achievement rows (kind ACHIEVEMENT, key "ACH:<id>") pay a one-time bonus, and
// SIGNAL rows are zero-point facts that achievements are built on. The unique
// (userId, key, refId) makes every award idempotent, so undo/redo can't farm
// points. User.communityScore is a denormalized SUM(points) kept in sync by
// src/lib/points.ts. Replaces the old ScoreEvent table (kept, no longer written).
model PointEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  kind      String
  points    Int
  refId     String   @default("")
  createdAt DateTime @default(now())

  @@unique([userId, key, refId])
  @@index([userId, createdAt])
  @@index([key])
  @@map("point_events")
}

// Small user-uploaded images (event posters), stored in Postgres so uploads
// need no extra storage service. Images are downscaled in the browser before
// upload and capped server-side, so rows stay small.
model Upload {
  id          String   @id @default(cuid())
  data        Bytes
  contentType String
  size        Int
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("uploads")
}

// ---------------------------------------------------------------------------
// Student Leaders Board: members, About page, announcements, polls, and
// initiatives (member-sponsored proposals the community votes on).

model SlbMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())

  @@map("slb_members")
}

// Single row (id "about"), editable by SLB members.
model SlbAbout {
  id          String   @id
  body        String
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@map("slb_about")
}

model SlbAnnouncement {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("slb_announcements")
}

model SlbPoll {
  id        String          @id @default(cuid())
  question  String
  authorId  String
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  closesAt  DateTime?
  options   SlbPollOption[]
  votes     SlbPollVote[]
  createdAt DateTime        @default(now())

  @@map("slb_polls")
}

model SlbPollOption {
  id       String        @id @default(cuid())
  pollId   String
  poll     SlbPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label    String
  position Int
  votes    SlbPollVote[]

  @@map("slb_poll_options")
}

model SlbPollVote {
  id        String        @id @default(cuid())
  pollId    String
  poll      SlbPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    SlbPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([pollId, userId])
  @@map("slb_poll_votes")
}

enum SlbInitiativeStatus {
  PROPOSED
  IN_PROGRESS
  PASSED
  NOT_PASSED
}

model SlbInitiative {
  id        String                @id @default(cuid())
  title     String
  summary   String
  body      String
  status    SlbInitiativeStatus   @default(PROPOSED)
  sponsorId String
  sponsor   User                  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  backers   SlbInitiativeBacker[]
  votes     SlbInitiativeVote[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("slb_initiatives")
}

// SLB members (other than the sponsor) who co-sponsor an initiative.
model SlbInitiativeBacker {
  id           String        @id @default(cuid())
  initiativeId String
  initiative   SlbInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@unique([initiativeId, userId])
  @@map("slb_initiative_backers")
}

// Community vote: +1 = "Yes, I want this", -1 = "No".
model SlbInitiativeVote {
  id           String        @id @default(cuid())
  initiativeId String
  initiative   SlbInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  value        Int

  @@unique([initiativeId, userId])
  @@map("slb_initiative_votes")
}

// One row per browser/device push subscription (a user may have several —
// phone, laptop, etc). endpoint is the push service URL PushManager.subscribe()
// returns; it's globally unique per subscription.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  deliveries PushDelivery[]

  @@index([userId])
  @@map("push_subscriptions")
}

// Delivery record for a single push send to a single subscription, used to
// drive retry-with-backoff and to give an auditable trail of what was sent
// and why a send failed. Not a full job queue (see PR notes) — attempts
// happen inline (with backoff) during the triggering request via
// `next/server`'s `after()`, and this table lets a follow-up sweep retry
// anything left FAILED.
model PushDelivery {
  id             String                @id @default(cuid())
  category       NotificationCategory
  title          String
  body           String
  url            String?
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   PushSubscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  status         PushDeliveryStatus
  attempts       Int                   @default(1)
  lastError      String?
  createdAt      DateTime              @default(now())

  @@index([userId])
  @@index([status])
  @@map("push_deliveries")
}

// Per-user, per-category push notification preference. Opt-out model: a
// missing row for a (userId, category) pair means "enabled" — see
// src/lib/notification-preferences.ts for the default-on read helper.
model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, category])
  @@map("notification_preferences")
}

// A user's four-year plan. One plan per user is marked primary (shown by
// default); additional plans are added via a "+" in the UI.
model AcademicPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isPrimary Boolean  @default(false)
  major     String?
  track     String?
  // "Completed a miniterm" — which miniterm doesn't matter, so this is a plain
  // checkbox rather than a planned course.
  miniTermCompleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses PlannedCourse[]

  @@index([userId])
  @@map("academic_plans")
}

model PlannedCourse {
  id        String       @id @default(cuid())
  planId    String
  plan      AcademicPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  year      Int
  semester  PlanSemester
  session   PlanSession
  code      String
  title     String?
  credits   String?
  isCrNc    Boolean      @default(false)
  genEdTags GenEdTag[]   @default([])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([planId])
  @@map("planned_courses")
}

// One row per (user, semester): records that the end-of-semester popup was
// shown/notified and whether the user dismissed it, so it appears once.
model SemesterCelebration {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterKey String
  notifiedAt  DateTime  @default(now())
  dismissedAt DateTime?

  @@unique([userId, semesterKey])
  @@map("semester_celebrations")
}

/// One-way follow. Two people who follow each other are "friends".
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}
