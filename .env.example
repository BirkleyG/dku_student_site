# --- Required ---

# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/dku_life"

# NextAuth session encryption secret — generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Comma-separated list of email domains allowed to sign up.
# NEXT_PUBLIC_ prefix is required — this is read on both client and server.
NEXT_PUBLIC_STUDENT_EMAIL_DOMAINS="dukekunshan.edu.cn,duke.edu"

# --- Optional ---

# NextAuth trusts the request host automatically on Vercel and in local dev;
# only set this if you're deploying somewhere else and hit an auth/host error.
# NEXTAUTH_URL="https://your-domain.example"

# Resend (transactional email) — leave unset and verification links are
# written to the server console / deployment logs instead of emailed.
RESEND_API_KEY=""
