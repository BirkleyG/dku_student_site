# --- Required ---

# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/dku_life"

# NextAuth session encryption secret — generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Comma-separated list of email domains allowed to sign up.
# NEXT_PUBLIC_ prefix is required — this is read on both client and server.
NEXT_PUBLIC_STUDENT_EMAIL_DOMAINS="dukekunshan.edu.cn,duke.edu"

# --- Optional ---

# NextAuth trusts the request host automatically on Vercel and in local dev;
# only set this if you're deploying somewhere else and hit an auth/host error.
# NEXTAUTH_URL="https://your-domain.example"

# Every signup needs an invite code, but only an admin can issue one — and
# there's no admin on an empty database. Set this to one netID to let that
# netID sign up once, with no code, as the first ADMIN, as long as the User
# table is still empty. Leave unset once an admin account exists.
# BOOTSTRAP_ADMIN_NETID="abc12"

# Resend (transactional email) — leave unset and verification links are
# written to the server console / deployment logs instead of emailed.
RESEND_API_KEY=""

# DKU Eats single sign-on. Without these, /eats still works — it just
# falls back to an unauthenticated embed instead of auto-logging users in.
# Get these from the Firebase Console for the DKU Eats project
# (eats-3f3fa): Project Settings -> Service Accounts -> Generate new
# private key. That downloads a JSON file with these exact fields.
EATS_FIREBASE_PROJECT_ID=""
EATS_FIREBASE_CLIENT_EMAIL=""
# Paste the "private_key" field's value as-is (its literal \n sequences
# are unescaped in code, so don't convert them to real newlines here).
EATS_FIREBASE_PRIVATE_KEY=""

# Where DKU Eats is actually hosted. Defaults to https://dkueats.com.
NEXT_PUBLIC_EATS_URL="https://dkueats.com"

# Web Push (VAPID) — without these, push notifications are silently a no-op
# (subscribing fails client-side with "not configured", and server sends throw).
# Generate a real pair with: npx web-push generate-vapid-keys
# NOT the placeholders below — these are not real keys and must never be used
# in production. Provision the real pair as environment secrets before this
# ships (see PR description).
VAPID_PUBLIC_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_PRIVATE_KEY="generate-with-npx-web-push-generate-vapid-keys"
# Contact the push service can reach if it needs to flag abuse — a mailto:
# or https: URL.
VAPID_SUBJECT="mailto:dev@example.com"
# Same value as VAPID_PUBLIC_KEY, but NEXT_PUBLIC_ so the browser can pass it
# to PushManager.subscribe(). Public keys are safe to expose; never do this
# with VAPID_PRIVATE_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="generate-with-npx-web-push-generate-vapid-keys"

# Where DKU Marketplace is actually hosted. Defaults to https://dku-market.kimi.site/.
NEXT_PUBLIC_MARKET_URL="https://dku-market.kimi.site/"
